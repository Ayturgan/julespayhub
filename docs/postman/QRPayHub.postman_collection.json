            "description": "Получение детальной информации о банке"
          }
        }
      ]
    },
    {
      "name": "💳 Payment Operations",
      "item": [
        {
          "name": "Create Payment Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_account\": \"1234567890123456\",\n  \"receiver_bank_code\": \"CBKG\",\n  \"receiver_name\": \"ИП Иванов Иван Иванович\",\n  \"description\": \"Оплата за товар в магазине 'Электроника'\",\n  \"amount\": 2500.00,\n  \"currency\": \"KGS\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/admin/create-payment",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "admin", "create-payment"]
            },
            "description": "Создание нового платежного запроса и генерация QR-кода"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"receiver_account\": \"1234567890123456\",\n  \"receiver_bank_code\": \"CBKG\",\n  \"receiver_name\": \"ИП Иванов Иван Иванович\",\n  \"description\": \"Оплата за товар в магазине 'Электроника'\",\n  \"amount\": 2500.00,\n  \"currency\": \"KGS\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v1/admin/create-payment",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "admin", "create-payment"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"qr_url\": \"https://api.qrpayhub.com/pay?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n  \"token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9...\",\n  \"expires_in\": 600\n}"
            }
          ]
        },
        {
          "name": "Get Payment Info",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Устанавливаем тестовый токен если не задан",
                  "if (!pm.variables.get('payment_token')) {",
                  "  pm.variables.set('payment_token', 'test_token_success_1000');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "User-Agent",
                "value": "{{user_agent}}"
              },
              {
                "key": "X-Device-ID",
                "value": "postman-test-device"
              },
              {
                "key": "X-App-Version",
                "value": "1.0.0"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/payment/payment-info?token={{payment_token}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment", "payment-info"],
              "query": [
                {
                  "key": "token",
                  "value": "{{payment_token}}"
                }
              ]
            },
            "description": "Получение информации о платеже по токену QR-кода"
          },
          "response": [
            {
              "name": "Success Response",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{access_token}}"
                  },
                  {
                    "key": "User-Agent",
                    "value": "{{user_agent}}"
                  }
                ],
                "url": {
                  "raw": "{{base_url}}/api/v1/payment/payment-info?token={{payment_token}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v1", "payment", "payment-info"],
                  "query": [
                    {
                      "key": "token",
                      "value": "{{payment_token}}"
                    }
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"receiver_account\": \"1234567890123456\",\n  \"receiver_bank_code\": \"CBKG\",\n  \"receiver_name\": \"ИП Иванов Иван Иванович\",\n  \"description\": \"Оплата за товар в магазине 'Электроника'\",\n  \"amount\": 2500.00,\n  \"currency\": \"KGS\",\n  \"payment_reference\": \"QRPAY240101001234\"\n}"
            }
          ]
        },
        {
          "name": "Send Payment Status (Success)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Генерация HMAC подписи",
                  "const CryptoJS = require('crypto-js');",
                  "",
                  "const method = 'POST';",
                  "const path = '/api/v1/payment/payment-status';",
                  "const body = pm.request.body.raw;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const hmacSecret = pm.variables.get('hmac_secret');",
                  "",
                  "// Формируем строку для подписи",
                  "const message = `${method}\\n${path}\\n${body}\\n${timestamp}`;",
                  "",
                  "// Вычисляем HMAC-SHA256",
                  "const signature = CryptoJS.HmacSHA256(message, hmacSecret).toString();",
                  "",
                  "// Устанавливаем заголовки",
                  "pm.variables.set('timestamp', timestamp);",
                  "pm.variables.set('signature', `sha256=${signature}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "{{user_agent}}"
              },
              {
                "key": "X-Signature",
                "value": "{{signature}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Transaction-ID",
                "value": "TXN240101123456"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{payment_token}}\",\n  \"status\": \"success\",\n  \"transaction_id\": \"TXN240101123456\",\n  \"amount\": 2500.00,\n  \"currency\": \"KGS\",\n  \"payer_phone\": \"+996555123456\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"fee_amount\": 25.00,\n  \"processing_time_ms\": 1250\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payment/payment-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment", "payment-status"]
            },
            "description": "Отправка webhook о успешном статусе платежа"
          }
        },
        {
          "name": "Send Payment Status (Failed)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Генерация HMAC подписи для неуспешного платежа",
                  "const CryptoJS = require('crypto-js');",
                  "",
                  "const method = 'POST';",
                  "const path = '/api/v1/payment/payment-status';",
                  "const body = pm.request.body.raw;",
                  "const timestamp = Math.floor(Date.now() / 1000).toString();",
                  "const hmacSecret = pm.variables.get('hmac_secret');",
                  "",
                  "const message = `${method}\\n${path}\\n${body}\\n${timestamp}`;",
                  "const signature = CryptoJS.HmacSHA256(message, hmacSecret).toString();",
                  "",
                  "pm.variables.set('timestamp', timestamp);",
                  "pm.variables.set('signature', `sha256=${signature}`);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "{{user_agent}}"
              },
              {
                "key": "X-Signature",
                "value": "{{signature}}"
              },
              {
                "key": "X-Timestamp",
                "value": "{{timestamp}}"
              },
              {
                "key": "X-Transaction-ID",
                "value": "TXN240101123457"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{payment_token}}\",\n  \"status\": \"failed\",\n  \"transaction_id\": \"TXN240101123457\",\n  \"amount\": 0,\n  \"currency\": \"KGS\",\n  \"payer_phone\": \"+996555123456\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"error_code\": \"INSUFFICIENT_FUNDS\",\n  \"error_message\": \"Недостаточно средств на счете\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/payment/payment-status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payment", "payment-status"]
            },
            "description": "Отправка webhook о неуспешном статусе платежа"
          }
        }
      ]
    },
