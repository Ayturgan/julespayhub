  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Глобальные переменные для всех запросов",
          "",
          "// Проверяем наличие токена",
          "if (!pm.variables.get('access_token') || pm.variables.get('access_token') === 'your-bank-access-token') {",
          "  console.warn('⚠️ Установите переменную access_token с реальным токеном банка');",
          "}",
          "",
          "// Проверяем наличие HMAC секрета",
          "if (!pm.variables.get('hmac_secret') || pm.variables.get('hmac_secret') === 'your-hmac-secret') {",
          "  console.warn('⚠️ Установите переменную hmac_secret с реальным секретом');",
          "}",
          "",
          "// Логируем информацию о запросе",
          "console.log(`🚀 Executing: ${pm.request.name}`);",
          "console.log(`📍 URL: ${pm.request.url}`);",
          "console.log(`🏦 Bank: ${pm.variables.get('bank_code')}`);"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Глобальные тесты для всех ответов",
          "",
          "// Проверяем время ответа",
          "pm.test('Response time is reasonable', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "// Проверяем заголовки безопасности",
          "pm.test('Security headers present', function () {",
          "  if (pm.response.headers.get('X-Request-ID')) {",
          "    pm.test('Request ID header present', function () {",
          "      pm.expect(pm.response.headers.get('X-Request-ID')).to.exist;",
          "    });",
          "  }",
          "});",
          "",
          "// Логируем результат",
          "if (pm.response.code === 200) {",
          "  console.log('✅ Request successful');",
          "} else {",
          "  console.log(`❌ Request failed with status: ${pm.response.code}`);",
          "  console.log(`📝 Response: ${pm.response.text()}`);",
          "}",
          "",
          "// Сохраняем полезные данные из ответов",
          "if (pm.response.code === 200) {",
          "  try {",
          "    const jsonData = pm.response.json();",
          "    ",
          "    // Сохраняем токен из создания платежа",
          "    if (jsonData.token && pm.request.name.includes('Create Payment')) {",
          "      pm.variables.set('payment_token', jsonData.token);",
          "      console.log('💾 Saved payment token for future requests');",
          "    }",
          "    ",
          "    // Сохраняем ID алерта",
          "    if (jsonData.alert_id && pm.request.name.includes('Alert')) {",
          "      pm.variables.set('alert_id', jsonData.alert_id);",
          "      console.log('💾 Saved alert ID for future requests');",
          "    }",
          "  } catch (e) {",
          "    // Не JSON ответ, пропускаем",
          "  }",
          "}"
        ]
      }
    }
  ]
}
